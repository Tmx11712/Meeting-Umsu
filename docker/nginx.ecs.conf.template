# ==========================================================
# Nginx untuk AWS ECS Fargate
# ----------------------------------------------------------
# File ini adalah TEMPLATE: image nginx resmi otomatis mengganti
# ${PHP_FPM_UPSTREAM} dan ${REVERB_UPSTREAM} dari environment variable saat start.
#
# - PHP_FPM_UPSTREAM : alamat PHP-FPM. Di ECS, container nginx & app berada
#                      dalam 1 Task Definition, jadi cukup 127.0.0.1:9000.
# - REVERB_UPSTREAM  : alamat Reverb. Jika Reverb jadi container di task yang sama
#                      gunakan 127.0.0.1:8080. Jika Reverb service terpisah, isi dengan
#                      DNS Service Connect / Cloud Map, misal reverb.enotulen.local:8080.
# ==========================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    root /var/www/html/public;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    index index.php;
    charset utf-8;

    # Harus >= batas validasi rekaman (200MB di StoreRecordingRequest)
    client_max_body_size 210M;

    # Upload besar & proses lama (AI) - selaraskan dengan idle timeout ALB
    fastcgi_read_timeout 300s;

    # Health check untuk AWS ALB Target Group -> diteruskan ke route Laravel /up
    location = /up {
        access_log off;
        try_files $uri /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Aset hasil build Vite memiliki hash di nama file -> aman di-cache lama oleh browser
    location /build/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass ${PHP_FPM_UPSTREAM};
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        # Tambahkan IP peer (ALB) ke X-Forwarded-For agar TrustProxies Laravel
        # mendapatkan IP user asli dan header tidak bisa dipalsukan.
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_hide_header X-Powered-By;

        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # WebSocket Reverb
    location /app {
        proxy_pass http://${REVERB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Scheme $scheme;
        proxy_set_header SERVER_PORT $server_port;
        proxy_set_header REMOTE_ADDR $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 60s;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # HTTP API Reverb
    location /apps {
        proxy_pass http://${REVERB_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header Scheme $scheme;
        proxy_set_header SERVER_PORT $server_port;
        proxy_set_header REMOTE_ADDR $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
