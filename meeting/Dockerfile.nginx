# ==========================================================
# Image Nginx untuk AWS ECS Fargate
# ----------------------------------------------------------
# Di Fargate tidak bisa berbagi Docker volume seperti di docker-compose,
# jadi file statis (public/build, images) di-"bake" langsung ke image Nginx.
#
# Aset disalin dari image APP yang sudah di-build, sehingga hash file Vite
# dijamin SAMA dengan manifest yang dibaca Laravel.
#
# Build (urutan penting):
#   docker build -t enotulen-app:TAG .
#   docker build -f Dockerfile.nginx --build-arg APP_IMAGE=enotulen-app:TAG -t enotulen-nginx:TAG .
# ==========================================================
ARG APP_IMAGE=enotulen-app:latest

FROM ${APP_IMAGE} AS app

FROM nginx:1.27-alpine

# Default upstream untuk ECS (container nginx & app dalam 1 task -> localhost)
ENV PHP_FPM_UPSTREAM=127.0.0.1:9000 \
    REVERB_UPSTREAM=127.0.0.1:8080

# Template akan diproses envsubst oleh entrypoint resmi image nginx
# menjadi /etc/nginx/conf.d/default.conf saat container start.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.ecs.conf.template /etc/nginx/templates/default.conf.template

# Salin file publik (index.php, build Vite, images, favicon, dll) dari image app
COPY --from=app /var/www/html/public /var/www/html/public

EXPOSE 80
