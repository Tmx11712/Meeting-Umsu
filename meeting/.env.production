APP_NAME="e-Notulen UMSU"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://notulen.umsu.ac.id

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nama_database_kampus
DB_USERNAME=user_database_kampus
DB_PASSWORD=password_aman

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID="KUNCI_MINIO_ATAU_S3"
AWS_SECRET_ACCESS_KEY="RAHASIA_MINIO_ATAU_S3"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET="meeting"
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT="http://127.0.0.1:9000"

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST="notulen.umsu.ac.id"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OPENAI_API_KEY="sk-xxxx"

