# ==========================================================
# TEMPLATE ENVIRONMENT PRODUCTION (AWS ECS) - e-Notulen UMSU
# ----------------------------------------------------------
# JANGAN isi rahasia asli di file ini (file ini ikut ter-push ke GitHub).
# Di AWS, simpan nilai rahasia di AWS Secrets Manager / SSM Parameter Store
# lalu inject ke ECS Task Definition sebagai environment variable / secrets.
# Baris bertanda [RAHASIA] WAJIB diganti dan disimpan di Secrets Manager.
# ==========================================================

APP_NAME="e-Notulen UMSU"
APP_ENV=production
# [RAHASIA] Generate dengan: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://notulen.umsu.ac.id
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Di container, log harus ke stderr agar terbaca oleh AWS CloudWatch Logs
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Amazon RDS (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=nama-instance.xxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=nama_database_kampus
DB_USERNAME=user_database_kampus
# [RAHASIA]
DB_PASSWORD=GANTI_DENGAN_PASSWORD_RDS
# Wajibkan koneksi terenkripsi ke RDS
DB_SSLMODE=require

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
# Harus lebih besar dari timeout job terpanjang (3600 detik)
REDIS_QUEUE_RETRY_AFTER=3700
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie session hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true

# --- Amazon ElastiCache (Redis) ---
# Jika "Encryption in-transit" ElastiCache aktif, gunakan prefix tls://
# contoh: REDIS_HOST=tls://master.nama-cluster.xxxxxx.apse1.cache.amazonaws.com
REDIS_CLIENT=phpredis
REDIS_HOST=nama-cluster.xxxxxx.apse1.cache.amazonaws.com
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email ---
MAIL_MAILER=resend
# [RAHASIA]
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@umsu.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Amazon S3 (penyimpanan rekaman & dokumen) ---
# WAJIB s3: container ECS bersifat sementara, file di disk lokal akan HILANG saat restart.
FILESYSTEM_DISK=s3
# Rekomendasi: KOSONGKAN key & secret, lalu beri izin S3 ke "ECS Task Role" (IAM).
# AWS SDK otomatis memakai kredensial dari Task Role tanpa menyimpan kunci.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=nama-bucket-enotulen
# Untuk Amazon S3 asli: endpoint KOSONG dan path-style FALSE.
# (Hanya diisi jika memakai MinIO, misal: AWS_ENDPOINT=http://minio:9000 & path-style true)
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Laravel Reverb (WebSocket) ---
# [RAHASIA] Ganti dengan string acak (misal: openssl rand -hex 16)
REVERB_APP_ID=GANTI_APP_ID
REVERB_APP_KEY=GANTI_APP_KEY
REVERB_APP_SECRET=GANTI_APP_SECRET
REVERB_HOST="notulen.umsu.ac.id"
REVERB_PORT=443
REVERB_SCHEME=https

# Variabel VITE_* di-"bake" saat docker build (build-arg), bukan saat runtime
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- OpenAI (Transkripsi & Ringkasan Notulen) ---
# [RAHASIA]
OPENAI_API_KEY="MASUKKAN_API_KEY_OPENAI_DI_SINI"
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4o-mini
TRANSCRIPTION_CONCURRENT_ENABLED=true
TRANSCRIPTION_CONCURRENT_THRESHOLD=1200
TRANSCRIPTION_CHUNK_DURATION=900
TRANSCRIPTION_CHUNK_OVERLAP=15

# --- Integrasi Sistem Absensi Kampus ---
ABSENSI_API_URL=
# [RAHASIA]
ABSENSI_API_KEY=
ABSENSI_SECRET_KEY=

# --- Khusus ECS (entrypoint container) ---
# Set true HANYA pada service web/app agar migrasi dijalankan saat deploy.
RUN_MIGRATIONS=false
